# ===========================================
# Exeller Computer Platform — Environment
# ===========================================
# Copy this file to .env.local and fill in values. Never commit secrets.

# --- Supabase (Required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BUSINESS_PHONE=+919999999999
NEXT_PUBLIC_UPI_ID=

# --- WhatsApp / Evolution API (Server-only) ---
EVOLUTION_API_URL=https://your-evolution-instance.railway.app
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE_NAME=exeller
STAFF_WHATSAPP_PHONE=+919999999999

# --- AI Services (Server-only) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# --- n8n Integration (Server-only) ---
N8N_WEBHOOK_SECRET=
WEBHOOK_SIGNING_SECRET=

# --- Telegram (optional staff alerts) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
