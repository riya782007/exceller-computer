# ===========================================
# Exceller Computer Platform — Environment
# ===========================================
# Copy this file to .env.local and fill in values

# --- Supabase (Required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BUSINESS_PHONE=+919999999999

# Optional explicit host for a dedicated, protected operations console.
# Defaults to any admin.* hostname if unset.
ADMIN_CONSOLE_HOST=admin.exellercomputer.com

# --- WhatsApp / Evolution API (Server-only) ---
EVOLUTION_API_URL=https://your-evolution-instance.railway.app
EVOLUTION_API_KEY=your-evolution-api-key

# --- AI Services (Server-only) ---
# Create this key at https://platform.openai.com/api-keys and add it only in
# Vercel. Never expose it through NEXT_PUBLIC_ variables or client code.
OPENAI_API_KEY=sk-...
# Optional. Default is gpt-4.1-mini.
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=sk-ant-...

# --- n8n Integration (Server-only) ---
N8N_WEBHOOK_SECRET=your-webhook-secret

# --- Webhook Signing (Server-only) ---
WEBHOOK_SIGNING_SECRET=your-signing-secret
